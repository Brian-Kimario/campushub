# CampusHub local configuration template.
# Copy to .env for local development. NEVER commit .env or put real secrets here.
# Every value below is a placeholder; generate real secrets locally (see docs/OPERATIONS.md).

# --- Database (MySQL 8, Docker Compose service "mysql") ---
CAMPUSHUB_DB_HOST=localhost
CAMPUSHUB_DB_PORT=3306
CAMPUSHUB_DB_NAME=campushub
# Runtime application user (least privilege). Migrations use a separate migration user.
CAMPUSHUB_DB_APP_USER=campushub_app
CAMPUSHUB_DB_APP_PASSWORD=change-me-local-only
CAMPUSHUB_DB_MIGRATION_USER=campushub_migrator
CAMPUSHUB_DB_MIGRATION_PASSWORD=change-me-local-only
MYSQL_ROOT_PASSWORD=change-me-root-local-only

# --- Authentication ---
# HS256 signing key, minimum 32 bytes (256 bits). Generate: openssl rand -base64 48
CAMPUSHUB_JWT_SECRET=replace-with-64-char-random-value
CAMPUSHUB_JWT_ISSUER=campushub
CAMPUSHUB_JWT_AUDIENCE=campushub-api
CAMPUSHUB_JWT_ACCESS_TTL_MINUTES=15

# --- CORS (comma-separated exact origins; no wildcards) ---
CAMPUSHUB_CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Files ---
CAMPUSHUB_STORAGE_ROOT=/var/campushub/storage
CAMPUSHUB_UPLOAD_MAX_FILE_BYTES=20971520
CAMPUSHUB_UPLOAD_MAX_FILES_PER_VERSION=5

# --- Time ---
# Institution time zone used to interpret deadlines entered without an offset (IANA name).
CAMPUSHUB_INSTITUTION_TIMEZONE=UTC

# --- Optional asynchronous pipeline (Phase 8 only; leave disabled by default) ---
CAMPUSHUB_KAFKA_ENABLED=false
CAMPUSHUB_KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- Local demo seeding (dev profile only; never enabled in production) ---
CAMPUSHUB_DEV_SEED_ENABLED=false
